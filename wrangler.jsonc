{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amir-roh-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "213ca7a0-0cde-416e-8cbf-20537b34da6f","database_name": "amir-roh-proxy1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "41351118e87644a8b4fb03cfa3cb6438" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
